<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions requested explicitly by user -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Queries for Text-to-Speech & Speech Recognition Intent -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_sora"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_sora"
        android:supportsRtl="true"
        android:theme="@style/Theme.SORA"
        android:usesCleartextTraffic="false">

        <!-- Login / Registration Entrance -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Voice Assistant Primary Screen -->
        <activity
            android:name=".VoiceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Authenticated conversation history -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false" />

        <!-- AI Text Chat Screen -->
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
