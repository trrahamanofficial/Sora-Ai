<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <!-- Assistant Message Container -->
    <LinearLayout
        android:id="@+id/layoutAssistant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="48dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAssistantProvider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:textColor="@color/cyan_400"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAssistantContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/bg_surface"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- User Message Container -->
    <LinearLayout
        android:id="@+id/layoutUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="48dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUserContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/cyan_900"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
