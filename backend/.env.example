# SORA Backend Part 1 — set these in Render Environment, not in source code.
NODE_ENV=production
PORT=10000

# Supabase project settings (Dashboard > Project Settings > API)
SUPABASE_URL=https://rkwnxsstnnqzjscpoxnd.supabase.co
SUPABASE_ANON_KEY=sb_publishable_qx6UIy__TOu9DOnyYPhJ9A_gnMRBern
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Generate a unique random secret (at least 32 characters); never change it
# after saving encrypted provider keys unless you re-encrypt those keys.
ENCRYPTION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Comma-separated deployed web origins. Example: https://your-sora.netlify.app
CORS_ORIGINS=https://YOUR_NETLIFY_SITE.netlify.app
APP_URL=https://YOUR_NETLIFY_SITE.netlify.app

# Optional provider environment keys. You can also add keys from the Admin UI
# in Part 2 after the backend and SQL migration are configured.
